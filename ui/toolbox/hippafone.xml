<document>
    <category name="%{BKY_CATLOGIC}" colour="%{BKY_LOGIC_HUE}">
      <block type="controls_if"></block>
      <block type="logic_compare"></block>
      <block type="logic_operation"></block>
      <block type="logic_negate"></block>
      <block type="logic_boolean"></block>
    </category>
    <category name="%{BKY_CATLOOPS}" colour="%{BKY_LOOPS_HUE}">
      <block type="hippa_forever"></block>
      <block type="controls_repeat_ext">
        <value name="TIMES"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
      </block>
      <block type="controls_whileUntil"></block>
      <block type="controls_for">
        <value name="FROM"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="TO"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
        <value name="BY"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      </block>
      <block type="controls_flow_statements"></block>
    </category>
    <category name="%{BKY_CATMATH}" colour="%{BKY_MATH_HUE}">
      <block type="math_number"><field name="NUM">123</field></block>
      <block type="math_arithmetic">
        <value name="A"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      </block>
      <block type="math_single">
        <value name="NUM"><shadow type="math_number"><field name="NUM">9</field></shadow></value>
      </block>
      <block type="math_number_property">
        <value name="NUMBER_TO_CHECK"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
      </block>
      <block type="math_round">
        <value name="NUM"><shadow type="math_number"><field name="NUM">3.1</field></shadow></value>
      </block>
      <block type="math_modulo">
        <value name="DIVIDEND"><shadow type="math_number"><field name="NUM">64</field></shadow></value>
        <value name="DIVISOR"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
      </block>
      <block type="math_random_int">
        <value name="FROM"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="TO"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
      </block>
    </category>
    <category name="%{BKY_CATTEXT}" colour="%{BKY_TEXTS_HUE}">
      <block type="text"></block>
      <block type="text_join"></block>
      <block type="text_length">
        <value name="VALUE"><shadow type="text"><field name="TEXT">abc</field></shadow></value>
      </block>
      <block type="text_isEmpty">
        <value name="VALUE"><shadow type="text"><field name="TEXT"></field></shadow></value>
      </block>
      <block type="text_indexOf">
        <value name="VALUE"><shadow type="text"><field name="TEXT">abc</field></shadow></value>
        <value name="FIND"><shadow type="text"><field name="TEXT">b</field></shadow></value>
      </block>
      <block type="text_charAt">
        <value name="VALUE"><shadow type="text"><field name="TEXT">abc</field></shadow></value>
      </block>
      <block type="text_changeCase">
        <value name="TEXT"><shadow type="text"><field name="TEXT">abc</field></shadow></value>
      </block>
      <block type="text_trim">
        <value name="TEXT"><shadow type="text"><field name="TEXT">abc</field></shadow></value>
      </block>
    </category>
    <category name="%{BKY_CATLISTS}" colour="%{BKY_LISTS_HUE}">
      <block type="lists_create_with"></block>
      <block type="lists_repeat">
        <value name="NUM"><shadow type="math_number"><field name="NUM">5</field></shadow></value>
      </block>
      <block type="lists_length"></block>
      <block type="lists_isEmpty"></block>
      <block type="lists_indexOf"></block>
      <block type="lists_getIndex"></block>
      <block type="lists_setIndex"></block>
    </category>
    <sep></sep>
    <category name="%{BKY_CATVARIABLES}" colour="%{BKY_VARIABLES_HUE}" custom="VARIABLE"></category>
    <category name="%{BKY_CATFUNCTIONS}" colour="%{BKY_PROCEDURES_HUE}" custom="PROCEDURE"></category>
    <sep></sep>
    <category name="Setup" colour="290">
      <label text="Run the setup script once, before your first program (see below)"></label>
      <button text="Download the HippaFone setup script" callbackKey="downloadHippaSetup"></button>
      <label text="Run it once, before your first program. It needs Python 3.10 or newer."></label>
      <label text="Windows: python deploy_all_to_adafruit_ESP32-S3_Feather_5477.py"></label>
      <label text="Ubuntu: python3 deploy_all_to_adafruit_ESP32-S3_Feather_5477.py"></label>
      <label text="Then pick the HippaFone board, connect, and build."></label>
      <label text="Examples" web-class="arc-examples"></label>
      <button text="Load example: hippafone_first_program" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_button_and_light" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_send_on_button" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_receive_and_show" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_job_hello_once" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_job_radio" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_job_typing" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_job_boot" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_job_pictures" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_messages" callbackKey="loadExample"></button>
      <button text="Load example: hippafone_messages_one_loop" callbackKey="loadExample"></button>
    </category>
    <category name="Screen" colour="290">
      <block type="hippa_screen_title">
        <value name="TEXT"><shadow type="text"><field name="TEXT">HippaFone</field></shadow></value>
      </block>
      <block type="hippa_screen_write">
        <value name="TEXT"><shadow type="text"><field name="TEXT">Hello</field></shadow></value>
      </block>
      <block type="hippa_screen_status">
        <value name="TEXT"><shadow type="text"><field name="TEXT">Hello</field></shadow></value>
      </block>
      <block type="hippa_screen_clear"></block>
      <block type="hippa_screen_redraw"></block>
      <block type="hippa_screen_rotate"></block>
      <block type="hippa_screen_width"></block>
      <block type="hippa_screen_height"></block>
      <block type="hippa_screen_box">
        <value name="X"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
        <value name="Y"><shadow type="math_number"><field name="NUM">50</field></shadow></value>
        <value name="W"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
        <value name="H"><shadow type="math_number"><field name="NUM">50</field></shadow></value>
      </block>
      <block type="hippa_screen_text">
        <value name="TEXT"><shadow type="text"><field name="TEXT">Hello</field></shadow></value>
        <value name="X"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
        <value name="Y"><shadow type="math_number"><field name="NUM">50</field></shadow></value>
      </block>
    </category>
    <category name="Pictures" colour="290">
      <block type="hippa_picture_show">
        <value name="NAME"><shadow type="text"><field name="TEXT">logo.bmp</field></shadow></value>
      </block>
      <block type="hippa_picture_show_xy">
        <value name="NAME"><shadow type="text"><field name="TEXT">logo.bmp</field></shadow></value>
        <value name="X"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
        <value name="Y"><shadow type="math_number"><field name="NUM">50</field></shadow></value>
      </block>
      <block type="hippa_picture_stop"></block>
      <block type="hippa_picture_list"></block>
    </category>
    <category name="Touch" colour="290">
      <block type="hippa_touch_tapped"></block>
      <block type="hippa_touch_down"></block>
      <block type="hippa_touch_x"></block>
      <block type="hippa_touch_y"></block>
    </category>
    <category name="Keyboard" colour="290">
      <block type="hippa_typed_line"></block>
      <block type="hippa_typing"></block>
      <block type="hippa_bluetooth_keyboard_on"></block>
      <block type="hippa_bluetooth_keyboard_ready"></block>
    </category>
    <category name="Radio" colour="290">
      <block type="hippa_radio_send">
        <value name="TEXT"><shadow type="text"><field name="TEXT">Hello</field></shadow></value>
      </block>
      <block type="hippa_radio_message"></block>
      <block type="hippa_radio_sender"></block>
      <block type="hippa_radio_words"></block>
      <block type="hippa_radio_rssi"></block>
      <block type="hippa_radio_snr"></block>
    </category>
    <category name="Light and buttons" colour="290">
      <block type="hippa_light"></block>
      <block type="hippa_light_rgb">
        <value name="R"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
        <value name="G"><shadow type="math_number"><field name="NUM">128</field></shadow></value>
        <value name="B"><shadow type="math_number"><field name="NUM">255</field></shadow></value>
      </block>
      <block type="hippa_light_flash">
        <value name="MS"><shadow type="math_number"><field name="NUM">150</field></shadow></value>
      </block>
      <block type="hippa_light_off"></block>
      <block type="hippa_button_pressed"></block>
      <block type="hippa_button_down"></block>
    </category>
    <category name="Battery and time" colour="290">
      <block type="hippa_battery_percent"></block>
      <block type="hippa_battery_volts"></block>
      <block type="hippa_wait">
        <value name="SECONDS"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      </block>
      <block type="hippa_now"></block>
    </category>
</document>
