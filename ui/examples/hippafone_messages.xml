  <block type="procedures_defnoreturn" id="b44" x="10" y="800"><comment pinned="false" h="80" w="200">Once, five seconds after the start, sends S3 handset online and shows it.</comment><field name="NAME">say hello once</field><statement name="STACK"><block type="controls_if" id="b43"><value name="IF0"><block type="logic_operation" id="b36"><field name="OP">AND</field><value name="A"><block type="logic_negate" id="b30"><value name="BOOL"><block type="variables_get" id="b29"><field name="VAR" id="var_sent">sent</field></block></value></block></value><value name="B"><block type="logic_compare" id="b35"><field name="OP">GT</field><value name="A"><block type="hippa_now" id="b31"></block></value><value name="B"><block type="math_arithmetic" id="b34"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b32"><field name="VAR" id="var_start">start</field></block></value><value name="B"><block type="math_number" id="b33"><field name="NUM">5</field></block></value></block></value></block></value></block></value><statement name="DO0"><block type="hippa_radio_send" id="b38"><value name="TEXT"><block type="text" id="b37"><field name="TEXT">S3 handset online</field></block></value><next><block type="hippa_screen_write" id="b40"><value name="TEXT"><block type="text" id="b39"><field name="TEXT">TX: S3 handset online</field></block></value><next><block type="variables_set" id="b42"><field name="VAR" id="var_sent">sent</field><value name="VALUE"><block type="logic_boolean" id="b41"><field name="BOOL">TRUE</field></block></value></block></next></block></next></block></statement></block></statement></block>
  <block type="procedures_defnoreturn" id="b59" x="10" y="1101"><comment pinned="false" h="80" w="200">When a radio message has come in, reads its signal, shows it, flashes the light green and shows the signal.</comment><field name="NAME">check the radio</field><statement name="STACK"><block type="variables_set" id="b46"><field name="VAR" id="var_msg">msg</field><value name="VALUE"><block type="hippa_radio_message" id="b45"></block></value><next><block type="controls_if" id="b58"><value name="IF0"><block type="logic_compare" id="b49"><field name="OP">NEQ</field><value name="A"><block type="variables_get" id="b47"><field name="VAR" id="var_msg">msg</field></block></value><value name="B"><block type="text" id="b48"><field name="TEXT"></field></block></value></block></value><statement name="DO0"><block type="variables_set" id="b51"><field name="VAR" id="var_rssi">rssi</field><value name="VALUE"><block type="hippa_radio_rssi" id="b50"></block></value><next><block type="variables_set" id="b53"><field name="VAR" id="var_snr">snr</field><value name="VALUE"><block type="hippa_radio_snr" id="b52"></block></value><next><block type="procedures_callnoreturn" id="b54"><mutation name="show the message"></mutation><next><block type="hippa_light_flash" id="b56"><field name="COLOUR">#00ff00</field><value name="MS"><block type="math_number" id="b55"><field name="NUM">150</field></block></value><next><block type="procedures_callnoreturn" id="b57"><mutation name="show the signal"></mutation></block></next></block></next></block></next></block></next></block></statement></block></next></block></statement></block>
  <block type="procedures_defnoreturn" id="b77" x="10" y="1447"><comment pinned="false" h="80" w="200">Writes the message on the screen, with the signal numbers after it when there is a reading.</comment><field name="NAME">show the message</field><statement name="STACK"><block type="variables_set" id="b63"><field name="VAR" id="var_line">line</field><value name="VALUE"><block type="text_join" id="b62"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="b60"><field name="TEXT">RX: </field></block></value><value name="ADD1"><block type="variables_get" id="b61"><field name="VAR" id="var_msg">msg</field></block></value></block></value><next><block type="controls_if" id="b74"><value name="IF0"><block type="logic_compare" id="b66"><field name="OP">NEQ</field><value name="A"><block type="variables_get" id="b64"><field name="VAR" id="var_rssi">rssi</field></block></value><value name="B"><block type="math_number" id="b65"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="variables_set" id="b73"><field name="VAR" id="var_line">line</field><value name="VALUE"><block type="text_join" id="b72"><mutation items="5"></mutation><value name="ADD0"><block type="variables_get" id="b67"><field name="VAR" id="var_line">line</field></block></value><value name="ADD1"><block type="text" id="b68"><field name="TEXT"> </field></block></value><value name="ADD2"><block type="variables_get" id="b69"><field name="VAR" id="var_rssi">rssi</field></block></value><value name="ADD3"><block type="text" id="b70"><field name="TEXT">/</field></block></value><value name="ADD4"><block type="variables_get" id="b71"><field name="VAR" id="var_snr">snr</field></block></value></block></value></block></statement><next><block type="hippa_screen_write" id="b76"><value name="TEXT"><block type="variables_get" id="b75"><field name="VAR" id="var_line">line</field></block></value></block></next></block></next></block></statement></block>
