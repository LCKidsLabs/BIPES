  <block type="procedures_defnoreturn" id="b338" x="10" y="250"><comment pinned="false" h="80" w="200">Remembers the time it started, sets sent to false and shows the title Hello job.</comment><field name="NAME">get ready</field><statement name="STACK"><block type="variables_set" id="b330"><field name="VAR" id="var_start">start</field><value name="VALUE"><block type="hippa_now" id="b329"></block></value><next><block type="variables_set" id="b332"><field name="VAR" id="var_sent">sent</field><value name="VALUE"><block type="logic_boolean" id="b331"><field name="BOOL">FALSE</field></block></value><next><block type="hippa_screen_title" id="b334"><value name="TEXT"><block type="text" id="b333"><field name="TEXT">Hello job</field></block></value></block></next></block></next></block></statement></block>
  <block type="procedures_defnoreturn" id="b354" x="10" y="483"><comment pinned="false" h="80" w="200">Once, five seconds after the start, sends S3 handset online and shows it.</comment><field name="NAME">say hello once</field><statement name="STACK"><block type="controls_if" id="b353"><value name="IF0"><block type="logic_operation" id="b346"><field name="OP">AND</field><value name="A"><block type="logic_negate" id="b340"><value name="BOOL"><block type="variables_get" id="b339"><field name="VAR" id="var_sent">sent</field></block></value></block></value><value name="B"><block type="logic_compare" id="b345"><field name="OP">GT</field><value name="A"><block type="hippa_now" id="b341"></block></value><value name="B"><block type="math_arithmetic" id="b344"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b342"><field name="VAR" id="var_start">start</field></block></value><value name="B"><block type="math_number" id="b343"><field name="NUM">5</field></block></value></block></value></block></value></block></value><statement name="DO0"><block type="hippa_radio_send" id="b348"><value name="TEXT"><block type="text" id="b347"><field name="TEXT">S3 handset online</field></block></value><next><block type="hippa_screen_write" id="b350"><value name="TEXT"><block type="text" id="b349"><field name="TEXT">TX: S3 handset online</field></block></value><next><block type="variables_set" id="b352"><field name="VAR" id="var_sent">sent</field><value name="VALUE"><block type="logic_boolean" id="b351"><field name="BOOL">TRUE</field></block></value></block></next></block></next></block></statement></block></statement></block>
